# Copy to .env next to docker-compose.yml, or run ./hearth.sh setup. Never commit .env.
# Every line is optional; a hub with this file unchanged works.

# Which release to run, and where the images come from.
HEARTH_VERSION=0.1.1
HEARTH_IMAGES=ghcr.io/xlucifersx/hearth

# The one folder that holds everything. On a Synology: /volume1/docker/hearth/data
HEARTH_DATA=./data

# Your time zone, for schedules and daily totals, like Europe/Berlin.
TZ=UTC

# The port the app connects to.
HEARTH_PORT=8780

# How phones on your Wi-Fi reach this hub, like http://192.168.1.20:8780. Casting uses it.
HUB_LAN_URL=
HUB_NAME=Home

# Home location (2 decimals is plenty) for sunrise and sunset automations.
HOME_LAT=
HOME_LON=

# Which optional parts run, comma separated:
#   zigbee    Zigbee2MQTT. Set a coordinator below first.
#   extras    the Alexa and Google bridge, and eufy cameras
#   watchdog  restarts services that hang; it holds the Docker socket
COMPOSE_PROFILES=

# --- Zigbee ---------------------------------------------------------------
# A USB stick: its path on this machine. Prefer /dev/serial/by-id/..., which survives a reboot.
ZIGBEE_DEVICE=
# A network coordinator instead: tcp://192.168.1.30:6638. Leave as it is for a USB stick.
ZIGBEE_PORT=/dev/zigbee
# ember (Sonoff Dongle-E, most Silicon Labs), zstack (Sonoff Dongle-P, most TI), deconz, zigate.
ZIGBEE_ADAPTER=
# Clear of Wi-Fi channels 1, 6 and 11. Only used on the very first start.
ZIGBEE_CHANNEL=25
# The Zigbee2MQTT web page's port.
ZIGBEE_UI_PORT=8099

# --- Network --------------------------------------------------------------
# The card Matter uses. Found from the default route when empty. On a Synology with Open vSwitch
# that's ovs_eth0.
MATTER_INTERFACE=
# Where drivers look for devices. Empty is this machine's own /24. A wider network: 192.168.0.0/22
NATIVE_SUBNET=

# --- Regions --------------------------------------------------------------
# Cloud accounts answer on regional addresses. Set these if you are outside the UK.
ALEXA_DOMAIN=amazon.co.uk
ALEXA_LOCALE=en-GB
EUFY_COUNTRY=GB
ANKER_COUNTRY=GB

# --- Optional -------------------------------------------------------------
# Thermostat target while Away is on.
AWAY_TEMP=16
# Use this admin token instead of the generated one, in data/gateway/admin-token.
HOMEAPP_TOKEN=
# An https address that reaches this hub from outside. See SECURITY.md.
HUB_PUBLIC_URL=
# Account sign-in through a hubs service of your own. Leave empty to connect with the admin token.
HOMEAPP_HUBS_URL=
AUTH_JWKS_URL=
# A SmartThings OAuth app of your own. The redirect must be an https page you run.
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=
SMARTTHINGS_REDIRECT=
# Push notifications need your own Apple developer account and your own build of the app.
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
